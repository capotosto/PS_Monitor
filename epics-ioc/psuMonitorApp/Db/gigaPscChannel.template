# Keep the public measurement alarm fields synchronized with device limits.
record(calcout, "$(P)$(R):$(CHAN):SYNC_VLOW") {
    field(INPA, "$(P)$(R):$(CHAN):VLOW_RBV NPP NMS")
    field(CALC, "A")
    field(OOPT, "Every Time")
    field(DOPT, "Use CALC")
    field(OUT,  "$(P)$(R):$(CHAN):VOLT.LOW NPP")
}

record(calcout, "$(P)$(R):$(CHAN):SYNC_VHIGH") {
    field(INPA, "$(P)$(R):$(CHAN):VHIGH_RBV NPP NMS")
    field(CALC, "A")
    field(OOPT, "Every Time")
    field(DOPT, "Use CALC")
    field(OUT,  "$(P)$(R):$(CHAN):VOLT.HIGH NPP")
}

record(calcout, "$(P)$(R):$(CHAN):SYNC_ILOW") {
    field(INPA, "$(P)$(R):$(CHAN):ILOW_RBV NPP NMS")
    field(CALC, "A")
    field(OOPT, "Every Time")
    field(DOPT, "Use CALC")
    field(OUT,  "$(P)$(R):$(CHAN):CURR.LOW NPP")
}

record(calcout, "$(P)$(R):$(CHAN):SYNC_IHIGH") {
    field(INPA, "$(P)$(R):$(CHAN):IHIGH_RBV NPP NMS")
    field(CALC, "A")
    field(OOPT, "Every Time")
    field(DOPT, "Use CALC")
    field(OUT,  "$(P)$(R):$(CHAN):CURR.HIGH NPP")
}

# Device-side alarm mask: bit 0 VLOW, bit 1 VHIGH, bit 2 ILOW, bit 3 IHIGH.
record(longin, "$(P)$(R):$(CHAN):ALARM_MASK") {
    field(DESC, "$(DESC) device alarm mask")
    field(DTYP, "PSC Reg")
    field(INP,  "@$(DEVICE) 3 $(SOFF)")
    field(SCAN, "I/O Intr")
}

record(calc, "$(P)$(R):$(CHAN):ANY_ALARM") {
    field(DESC, "$(DESC) any device alarm")
    field(INPA, "$(P)$(R):$(CHAN):ALARM_MASK CP NMS")
    field(INPB, "$(P)$(R):CONNECTED CP MS")
    field(CALC, "A!=0")
    field(HIGH, "0.5")
    field(HSV,  "MAJOR")
}

# Immediate persistent writes through PSC Single F32 message ID 10.
# info(SYNC, "SAME") lets Arduino echo the actual accepted value back.
record(ao, "$(P)$(R):$(CHAN):VLOW_SP") {
    field(DESC, "$(DESC) voltage low setpoint")
    field(DTYP, "PSC Single F32")
    field(OUT,  "@$(DEVICE) 10 $(VLOWADDR)")
    field(PREC, "4")
    field(EGU,  "V")
    field(FLNK, "$(P)$(R):SEND_ALL")
    info(SYNC, "SAME")
}

record(ao, "$(P)$(R):$(CHAN):VHIGH_SP") {
