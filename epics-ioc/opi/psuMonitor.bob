  <widget type="label" version="2.0.0">
    <name>Connection_Badge</name>
    <text>CONNECTION</text>
    <x>805</x>
    <y>18</y>
    <width>150</width>
    <height>48</height>
    <font>
      <font name="Connection_Badge_font" family="Liberation Sans" style="BOLD" size="15.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color red="154" green="40" blue="48">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="Connected color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0&gt;0.5">
          <value>
            <color name="Connected" red="27" green="116" blue="72">
            </color>
          </value>
        </exp>
        <pv_name>$(P)$(R):CONNECTED</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Connection_State</name>
    <text>DISCONNECTED</text>
    <x>965</x>
    <y>18</y>
    <width>245</width>
    <height>48</height>
    <font>
      <font name="Connection_State_font" family="Liberation Sans" style="BOLD" size="17.0">
      </font>
    </font>
    <foreground_color>
      <color red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color name="Disconnected" red="154" green="40" blue="48">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="Connection text" prop_id="text" out_exp="false">
        <exp bool_exp="pv0&gt;0.5">
          <value>CONNECTED</value>
        </exp>
        <pv_name>$(P)$(R):CONNECTED</pv_name>
      </rule>
      <rule name="Connection color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0&gt;0.5">
          <value>
            <color name="Connected" red="27" green="116" blue="72">
            </color>
          </value>
        </exp>
        <pv_name>$(P)$(R):CONNECTED</pv_name>
      </rule>
    </rules>
  </widget>
